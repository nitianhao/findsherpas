# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/data/

# Local data files
.cache/
*.xlsx
*.csv
# Keyword research: ignore intermediate data, keep the final backlog.
# Note: the pattern must exclude the directory *contents* (`data/*`), not the
# directory itself. Git cannot re-include a file whose parent directory is
# excluded, so `data/` followed by `!data/backlog.csv` would silently fail.
src/keyword-research/data/*
!src/keyword-research/data/backlog.csv

# Find Sherpas audit local runtime artifacts
reports/*
!reports/report_slugs.json
src/audit/reports/
src/audit/.env
src/audit/.venv/
src/audit/.venv*/
__pycache__/

# Report passwords — local only, never committed
reports/passwords.json
